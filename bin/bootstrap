#!/usr/bin/env bash

### n8-ansible Bootstrap Script
# Quick setup for new hosts to join the ansible-managed infrastructure
# 
# QUICKSETUP - Run this command:
# bash <(curl -fsSL https://raw.githubusercontent.com/nsheaps/n8-ansible/main/bin/bootstrap)

set -euo pipefail

# Script configuration
SCRIPT_VERSION="2.1.0"
REPO_DEFAULT="https://github.com/nsheaps/n8-ansible.git"
REPO_NAME="n8-ansible"
DEFAULT_BRANCH="main"

# Platform detection variables
OS_TYPE="unknown"
DISTRO="unknown"
IS_WSL=false
IS_MAC=false
IS_LINUX=false

# Early platform detection for gum installation
detect_platform_early() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        OS_TYPE="macos"
        IS_MAC=true
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        OS_TYPE="linux"
        IS_LINUX=true
        
        # Check for WSL
        if grep -qi microsoft /proc/version 2>/dev/null; then
            IS_WSL=true
        fi
        
        # Detect distribution
        if [ -f /etc/os-release ]; then
            . /etc/os-release
            DISTRO="${ID}"
        fi
    else
        echo "ERROR: Unsupported platform: $OSTYPE"
        exit 1
    fi
}

# Install gum early for better UI
install_gum_early() {
    if command -v gum &> /dev/null; then
        return 0
    fi
    
    echo "Installing gum for better user interface..."
    
    if [ "$IS_MAC" = true ]; then
        # Install Homebrew if needed
        if ! command -v brew &> /dev/null; then
            echo "Installing Homebrew first..."
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            
            # Add Homebrew to PATH for Apple Silicon Macs
            if [[ -f "/opt/homebrew/bin/brew" ]]; then
                eval "$(/opt/homebrew/bin/brew shellenv)"
            fi
        fi
        brew install gum
    elif [ "$IS_LINUX" = true ]; then
        case "$DISTRO" in
            ubuntu|debian)
                sudo apt-get update
                sudo mkdir -p /etc/apt/keyrings
                curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
                echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
                sudo apt-get update && sudo apt-get install -y gum
                ;;
            fedora|rhel|centos)
                echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/yum.repos.d/charm.repo
                sudo dnf install -y gum
                ;;
            arch)
                if ! command -v yay &> /dev/null; then
                    git clone https://aur.archlinux.org/yay.git /tmp/yay
                    cd /tmp/yay
                    makepkg -si --noconfirm
                    cd -
                    rm -rf /tmp/yay
                fi
                yay -S --noconfirm gum
                ;;
            *)
                echo "WARNING: Cannot install gum automatically for $DISTRO"
                echo "Please install gum manually: https://github.com/charmbracelet/gum"
                ;;
        esac
    fi
}

# Cleanup on exit
WORKING_DIR="$(pwd)"
function cleanup() {
    exit_code="$?"
    cd "$WORKING_DIR"
    if [ "${exit_code}" -eq 0 ]; then
        if command -v gum &> /dev/null; then
            gum style --foreground 212 --border-foreground 212 --border double --align center --width 50 --margin "1 2" --padding "2 4" \
                "Bootstrap Completed Successfully!" \
                "Your system will automatically pull" \
                "updates every 30 minutes"
        else
            echo "Bootstrap completed successfully!"
        fi
    else
        if command -v gum &> /dev/null; then
            gum style --foreground 196 --border-foreground 196 --border thick --align center --width 50 --margin "1 2" --padding "1 2" \
                "Bootstrap Failed" \
                "Exit code: ${exit_code}"
        else
            echo "Bootstrap failed with exit code ${exit_code}"
        fi
    fi
    exit "${exit_code}"
}
trap cleanup EXIT

# Platform detection with gum output
detect_platform() {
    gum spin --spinner dot --title "Detecting platform..." -- sleep 1
    
    local platform_msg=""
    if [ "$IS_MAC" = true ]; then
        platform_msg="macOS"
    elif [ "$IS_WSL" = true ]; then
        platform_msg="WSL on Linux ($DISTRO)"
    elif [ "$IS_LINUX" = true ]; then
        platform_msg="Linux ($DISTRO)"
    fi
    
    gum style --foreground 212 "Platform detected: $platform_msg"
}

# Check for required commands
check_command() {
    if ! command -v "$1" &> /dev/null; then
        return 1
    fi
    return 0
}

# Install packages based on platform
install_packages() {
    gum style --bold "Installing required packages..."
    
    if [ "$IS_MAC" = true ]; then
        install_packages_mac
    elif [ "$IS_LINUX" = true ]; then
        case "$DISTRO" in
            ubuntu|debian)
                install_packages_debian
                ;;
            fedora|rhel|centos)
                install_packages_fedora
                ;;
            arch)
                install_packages_arch
                ;;
            *)
                gum style --foreground 196 "Unsupported Linux distribution: $DISTRO"
                exit 1
                ;;
        esac
    fi
}

install_packages_mac() {
    # Homebrew should already be installed from gum installation
    gum spin --spinner dot --title "Installing packages with Homebrew..." -- \
        brew install git gh curl ansible 1password-cli
}

install_packages_debian() {
    gum spin --spinner dot --title "Updating apt sources..." -- \
        sudo apt-get update
    
    gum spin --spinner dot --title "Installing packages with apt..." -- \
        sudo apt-get install -y git gh curl ansible ca-certificates openssh-client
    
    # Install 1Password CLI if not present
    if ! check_command op; then
        gum spin --spinner dot --title "Installing 1Password CLI..." -- bash -c '
            curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
                sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | \
                sudo tee /etc/apt/sources.list.d/1password.list
            sudo apt-get update && sudo apt-get install -y 1password-cli
        '
    fi
}

install_packages_fedora() {
    gum spin --spinner dot --title "Installing packages with dnf..." -- \
        sudo dnf install -y git gh curl ansible ca-certificates openssh-clients
    
    # Install 1Password CLI if not present
    if ! check_command op; then
        gum spin --spinner dot --title "Installing 1Password CLI..." -- bash -c '
            sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
            sudo sh -c "echo -e \"[1password]\nname=1Password Stable Channel\nbaseurl=https://downloads.1password.com/linux/rpm/stable/\\\$basearch\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=https://downloads.1password.com/linux/keys/1password.asc\" > /etc/yum.repos.d/1password.repo"
            sudo dnf install -y 1password-cli
        '
    fi
}

install_packages_arch() {
    gum spin --spinner dot --title "Installing packages with pacman..." -- \
        sudo pacman -Syu --noconfirm git github-cli curl ansible openssh ca-certificates
    
    # Install from AUR if yay is available
    if check_command yay; then
        gum spin --spinner dot --title "Installing AUR packages..." -- \
            yay -S --noconfirm 1password-cli
    fi
}

# Optional SSH setup
setup_ssh_optional() {
    if gum confirm "Would you like to set up SSH server access?"; then
        setup_ssh
    else
        gum style --foreground 214 "Skipping SSH server setup (not required for ansible-pull)"
    fi
}

# Setup SSH based on platform
setup_ssh() {
    gum style --bold "Setting up SSH..."
    
    if [ "$IS_MAC" = true ]; then
        # Enable SSH on macOS
        gum spin --spinner dot --title "Enabling SSH on macOS..." -- \
            sudo systemsetup -setremotelogin on 2>/dev/null || \
            sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || \
            (gum style --foreground 214 "Could not enable SSH automatically. Please enable it in System Preferences > Sharing > Remote Login" && false)
        
        if [ $? -eq 0 ]; then
            gum style --foreground 212 "SSH enabled successfully"
        fi
    elif [ "$IS_LINUX" = true ]; then
        # Install SSH server if requested
        if gum confirm "Install OpenSSH server?"; then
            case "$DISTRO" in
                ubuntu|debian)
                    gum spin --spinner dot --title "Installing OpenSSH server..." -- \
                        sudo apt-get install -y openssh-server
                    ;;
                fedora|rhel|centos)
                    gum spin --spinner dot --title "Installing OpenSSH server..." -- \
                        sudo dnf install -y openssh-server
                    ;;
                arch)
                    gum spin --spinner dot --title "Installing OpenSSH server..." -- \
                        sudo pacman -S --noconfirm openssh
                    ;;
            esac
            
            # Enable and start SSH service
            if systemctl is-enabled ssh &>/dev/null || systemctl is-enabled sshd &>/dev/null; then
                gum spin --spinner dot --title "Starting SSH service..." -- \
                    sudo systemctl enable --now ssh 2>/dev/null || sudo systemctl enable --now sshd 2>/dev/null
                gum style --foreground 212 "SSH service enabled and started"
            fi
        fi
    fi
    
    # Create SSH directory if it doesn't exist
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
}

# Login to 1Password
setup_1password() {
    gum style --bold "Setting up 1Password CLI..."
    
    # Check if already signed in
    if op account list &>/dev/null; then
        gum style --foreground 212 "Already signed in to 1Password"
        return 0
    fi
    
    # Sign in to 1Password
    gum style "Please sign in to 1Password"
    if ! eval $(op signin); then
        gum style --foreground 196 "Failed to sign in to 1Password"
        if gum confirm "Continue without 1Password? (secrets won't be available)"; then
            gum style --foreground 214 "Continuing without 1Password integration"
            return 0
        else
            exit 1
        fi
    fi
    
    gum style --foreground 212 "Successfully signed in to 1Password"
}

# Login to GitHub CLI
setup_github() {
    gum style --bold "Setting up GitHub CLI..."
    
    # Check if already authenticated
    if gh auth status &>/dev/null; then
        gum style --foreground 212 "Already authenticated with GitHub"
        return 0
    fi
    
    # Authenticate with GitHub
    gum style "Please authenticate with GitHub"
    gh auth login
    
    if gh auth status &>/dev/null; then
        gum style --foreground 212 "Successfully authenticated with GitHub"
    else
        gum style --foreground 214 "GitHub authentication skipped"
    fi
}

# Clone or update the repository
setup_repository() {
    local repo="${1:-$REPO_DEFAULT}"
    local target_dir="$HOME/src/$REPO_NAME"
    
    gum style --bold "Setting up repository: $repo"
    
    # Check if already cloned
    if [ -d "$target_dir" ]; then
        cd "$target_dir"
        if [ "$(git config --get remote.origin.url)" = "$repo" ]; then
            gum spin --spinner dot --title "Repository exists, pulling latest changes..." -- \
                git pull
            ROOT_DIR="$(pwd)"
            export ROOT_DIR
            gum style --foreground 212 "Repository updated successfully"
            return 0
        else
            gum style --foreground 196 "Directory exists but has different remote: $(git config --get remote.origin.url)"
            exit 1
        fi
    fi
    
    # Ask where to clone
    target_dir=$(gum input --placeholder "$HOME/src/$REPO_NAME" --value "$HOME/src/$REPO_NAME" --prompt "Where to clone repository? ")
    
    # Clone the repository
    mkdir -p "$(dirname "$target_dir")"
    gum spin --spinner dot --title "Cloning repository..." -- \
        git clone "$repo" "$target_dir"
    
    cd "$target_dir"
    ROOT_DIR="$(pwd)"
    export ROOT_DIR
    gum style --foreground 212 "Repository cloned successfully to $target_dir"
}

# Generate host_vars file for this host
generate_host_vars() {
    local hostname
    hostname="$(hostname -s)"
    local host_vars_file="$ROOT_DIR/host_vars/${hostname}.yml"
    
    if [ -f "$host_vars_file" ]; then
        gum style --foreground 214 "Host vars file already exists: $host_vars_file"
        if gum confirm "View existing configuration?"; then
            gum pager < "$host_vars_file"
        fi
        return 0
    fi
    
    gum style --bold "Generating host configuration..."
    
    # Determine if workstation or server
    local host_type="server"
    if [ "$IS_MAC" = true ] || [ -n "${DISPLAY:-}" ] || [ "$IS_WSL" = true ]; then
        host_type="workstation"
    fi
    
    # Ask user to confirm or change
    host_type=$(gum choose --header "Select host type:" "workstation" "server" --selected="$host_type")
    
    # Ask for user profile
    local user_profile=$(gum choose --header "Select user profile:" "nsheaps" "nheaps" "custom")
    
    if [ "$user_profile" = "custom" ]; then
        user_profile=$(gum input --placeholder "profile_name" --prompt "Enter profile name: ")
    fi
    
    # Create host_vars file
    cat > "$host_vars_file" << EOF
---
# Configuration for $hostname
# Generated by bootstrap script on $(date)

# Ansible-pull configuration
ansible_pull_enabled: true
ansible_pull_cron_minute: "*/30"
ansible_pull_cron_hour: "*"

# User configuration
user_configs:
  - system_user: root
    config_profile: root
  - system_user: $(whoami)
    config_profile: $user_profile

# Host type: $host_type
EOF
    
    gum style --foreground 212 "Generated host_vars file: $host_vars_file"
    
    # Update inventory
    local inventory_file="$ROOT_DIR/hosts"
    if ! grep -q "^$hostname" "$inventory_file" 2>/dev/null; then
        gum spin --spinner dot --title "Adding $hostname to inventory..." -- bash -c "
            echo '' >> '$inventory_file'
            echo '[$host_type]' >> '$inventory_file'
            echo '$hostname' >> '$inventory_file'
        "
        gum style --foreground 212 "Added $hostname to inventory as $host_type"
    fi
}

# Run bootstrap playbook
run_bootstrap() {
    gum style --bold "Running bootstrap playbook..."
    
    cd "$ROOT_DIR"
    
    # First, do a dry run
    gum spin --spinner dot --title "Performing dry run..." -- \
        ansible-playbook playbooks/bootstrap.yml \
            --connection=local \
            --check \
            --diff \
            --extra-vars "running_as=$(whoami) root_dir=$ROOT_DIR" 2>&1
    
    # Ask for confirmation
    if gum confirm "The dry run completed. Would you like to proceed with the actual bootstrap?"; then
        # Run the actual bootstrap
        gum style "Running bootstrap (this will require sudo)..."
        ansible-playbook playbooks/bootstrap.yml \
            --connection=local \
            --ask-become-pass \
            --extra-vars "running_as=$(whoami) root_dir=$ROOT_DIR"
        
        gum style --foreground 212 "Bootstrap playbook completed"
    else
        gum style --foreground 214 "Bootstrap cancelled"
        return 1
    fi
}

# Run first ansible-pull
run_first_pull() {
    gum style --bold "First ansible-pull setup"
    
    # Ask for confirmation
    if gum confirm "Would you like to run the first ansible-pull now?" --affirmative "Yes, configure my system" --negative "No, I'll do it later"; then
        # Run ansible-pull
        gum style "Running ansible-pull (this will require sudo)..."
        sudo ansible-pull \
            -U "$REPO_DEFAULT" \
            -C "$DEFAULT_BRANCH" \
            --ask-become-pass
        
        gum style --foreground 212 "First ansible-pull completed"
    else
        gum style --foreground 214 "You can run ansible-pull manually later with:"
        gum style --foreground 245 "  sudo ansible-pull -U $REPO_DEFAULT -C $DEFAULT_BRANCH"
    fi
}

# Main execution
main() {
    # Early platform detection for gum installation
    detect_platform_early
    
    # Install gum first for better UI
    install_gum_early
    
    # Now we can use gum for everything
    gum style \
        --foreground 212 \
        --border-foreground 212 \
        --border double \
        --align center \
        --width 50 \
        --margin "1 2" \
        --padding "2 4" \
        "n8-ansible Bootstrap" \
        "Version $SCRIPT_VERSION"
    
    # Check for sudo access
    gum spin --spinner dot --title "Checking sudo access..." -- sudo -v
    gum style --foreground 212 "Sudo access confirmed"
    
    # Detect platform with gum output
    detect_platform
    
    # Install required packages
    install_packages
    
    # Optional SSH setup
    setup_ssh_optional
    
    # Setup 1Password
    setup_1password
    
    # Setup GitHub
    setup_github
    
    # Setup repository
    repo_url="${1:-}"
    if [ -z "$repo_url" ]; then
        repo_url=$(gum input --placeholder "$REPO_DEFAULT" --value "$REPO_DEFAULT" --prompt "Repository URL: ")
    fi
    setup_repository "$repo_url"
    
    # Generate host_vars
    generate_host_vars
    
    # Run bootstrap
    if run_bootstrap; then
        # Run first ansible-pull
        run_first_pull
    fi
}

# Run main function
main "$@"