#!/usr/bin/env bash

### n8-ansible Bootstrap Script
# Quick setup for new hosts to join the ansible-managed infrastructure
# 
# QUICKSETUP - Run this command:
# bash <(curl -fsSL https://raw.githubusercontent.com/nsheaps/n8-ansible/main/bin/bootstrap)

set -euo pipefail

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Script configuration
SCRIPT_VERSION="2.0.0"
REPO_DEFAULT="https://github.com/nsheaps/n8-ansible.git"
REPO_NAME="n8-ansible"
DEFAULT_BRANCH="main"

# Platform detection
OS_TYPE="unknown"
DISTRO="unknown"
IS_WSL=false
IS_MAC=false
IS_LINUX=false

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Cleanup on exit
WORKING_DIR="$(pwd)"
function cleanup() {
    exit_code="$?"
    cd "$WORKING_DIR"
    if [ $exit_code -eq 0 ]; then
        log_success "Bootstrap completed successfully!"
    else
        log_error "Bootstrap failed with exit code $exit_code"
    fi
    exit "$exit_code"
}
trap cleanup EXIT

# Platform detection
detect_platform() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        OS_TYPE="macos"
        IS_MAC=true
        log_info "Detected macOS"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        OS_TYPE="linux"
        IS_LINUX=true
        
        # Check for WSL
        if grep -qi microsoft /proc/version 2>/dev/null; then
            IS_WSL=true
            log_info "Detected WSL environment"
        fi
        
        # Detect distribution
        if [ -f /etc/os-release ]; then
            . /etc/os-release
            DISTRO="$ID"
            log_info "Detected Linux distribution: $DISTRO"
        fi
    else
        log_error "Unsupported platform: $OSTYPE"
        exit 1
    fi
}

# Check for required commands
check_command() {
    if ! command -v "$1" &> /dev/null; then
        return 1
    fi
    return 0
}

# Install packages based on platform
install_packages() {
    log_info "Installing required packages..."
    
    if [ "$IS_MAC" = true ]; then
        install_packages_mac
    elif [ "$IS_LINUX" = true ]; then
        case "$DISTRO" in
            ubuntu|debian)
                install_packages_debian
                ;;
            fedora|rhel|centos)
                install_packages_fedora
                ;;
            arch)
                install_packages_arch
                ;;
            *)
                log_error "Unsupported Linux distribution: $DISTRO"
                exit 1
                ;;
        esac
    fi
}

install_packages_mac() {
    # Install Homebrew if not present
    if ! check_command brew; then
        log_info "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        
        # Add Homebrew to PATH for Apple Silicon Macs
        if [[ -f "/opt/homebrew/bin/brew" ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi
    
    log_info "Installing packages with Homebrew..."
    brew install \
        git \
        gh \
        curl \
        ansible \
        1password-cli \
        gum \
        openssh
}

install_packages_debian() {
    log_info "Updating apt sources..."
    sudo apt-get update
    
    # Install gum if not present
    if ! check_command gum; then
        log_info "Installing gum..."
        sudo mkdir -p /etc/apt/keyrings
        curl -fsSL https://repo.charm.sh/apt/gpg.key | sudo gpg --dearmor -o /etc/apt/keyrings/charm.gpg
        echo "deb [signed-by=/etc/apt/keyrings/charm.gpg] https://repo.charm.sh/apt/ * *" | sudo tee /etc/apt/sources.list.d/charm.list
        sudo apt-get update
    fi
    
    log_info "Installing packages with apt..."
    sudo apt-get install -y \
        git \
        gh \
        curl \
        ansible \
        gum \
        openssh-server \
        ca-certificates
    
    # Install 1Password CLI
    if ! check_command op; then
        log_info "Installing 1Password CLI..."
        curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
            sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | \
            sudo tee /etc/apt/sources.list.d/1password.list
        sudo apt-get update && sudo apt-get install -y 1password-cli
    fi
}

install_packages_fedora() {
    log_info "Installing packages with dnf..."
    sudo dnf install -y \
        git \
        gh \
        curl \
        ansible \
        openssh-server \
        ca-certificates
    
    # Install 1Password CLI
    if ! check_command op; then
        log_info "Installing 1Password CLI..."
        sudo rpm --import https://downloads.1password.com/linux/keys/1password.asc
        sudo sh -c 'echo -e "[1password]\nname=1Password Stable Channel\nbaseurl=https://downloads.1password.com/linux/rpm/stable/\$basearch\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=1\ngpgkey=\"https://downloads.1password.com/linux/keys/1password.asc\"" > /etc/yum.repos.d/1password.repo'
        sudo dnf install -y 1password-cli
    fi
    
    # Install gum
    if ! check_command gum; then
        log_info "Installing gum..."
        echo '[charm]
name=Charm
baseurl=https://repo.charm.sh/yum/
enabled=1
gpgcheck=1
gpgkey=https://repo.charm.sh/yum/gpg.key' | sudo tee /etc/yum.repos.d/charm.repo
        sudo dnf install -y gum
    fi
}

install_packages_arch() {
    log_info "Installing packages with pacman..."
    sudo pacman -Syu --noconfirm \
        git \
        github-cli \
        curl \
        ansible \
        openssh \
        ca-certificates
    
    # Install from AUR
    if ! check_command yay; then
        log_info "Installing yay for AUR access..."
        git clone https://aur.archlinux.org/yay.git /tmp/yay
        cd /tmp/yay
        makepkg -si --noconfirm
        cd -
        rm -rf /tmp/yay
    fi
    
    log_info "Installing AUR packages..."
    yay -S --noconfirm 1password-cli gum
}

# Setup SSH based on platform
setup_ssh() {
    log_info "Setting up SSH..."
    
    if [ "$IS_MAC" = true ]; then
        # Enable SSH on macOS
        log_info "Enabling SSH on macOS..."
        sudo systemsetup -setremotelogin on 2>/dev/null || \
            sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || \
            log_warning "Could not enable SSH automatically. Please enable it in System Preferences > Sharing > Remote Login"
    elif [ "$IS_LINUX" = true ]; then
        # Ensure SSH service is running
        if systemctl is-enabled ssh &>/dev/null || systemctl is-enabled sshd &>/dev/null; then
            sudo systemctl enable --now ssh 2>/dev/null || sudo systemctl enable --now sshd 2>/dev/null
            log_success "SSH service enabled and started"
        fi
    fi
    
    # Create SSH directory if it doesn't exist
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
}

# Login to 1Password
setup_1password() {
    log_info "Setting up 1Password CLI..."
    
    # Check if already signed in
    if op account list &>/dev/null; then
        log_success "Already signed in to 1Password"
        return 0
    fi
    
    # Sign in to 1Password
    log_info "Please sign in to 1Password"
    if ! eval $(op signin); then
        log_error "Failed to sign in to 1Password"
        exit 1
    fi
    
    log_success "Successfully signed in to 1Password"
}

# Login to GitHub CLI
setup_github() {
    log_info "Setting up GitHub CLI..."
    
    # Check if already authenticated
    if gh auth status &>/dev/null; then
        log_success "Already authenticated with GitHub"
        return 0
    fi
    
    # Authenticate with GitHub
    log_info "Please authenticate with GitHub"
    gh auth login
    
    log_success "Successfully authenticated with GitHub"
}

# Clone or update the repository
setup_repository() {
    local repo="${1:-$REPO_DEFAULT}"
    local target_dir="$HOME/src/$REPO_NAME"
    
    log_info "Setting up repository: $repo"
    
    # Check if already cloned
    if [ -d "$target_dir" ]; then
        cd "$target_dir"
        if [ "$(git config --get remote.origin.url)" = "$repo" ]; then
            log_info "Repository exists, pulling latest changes..."
            git pull
            ROOT_DIR="$(pwd)"
            export ROOT_DIR
            return 0
        else
            log_error "Directory exists but has different remote: $(git config --get remote.origin.url)"
            exit 1
        fi
    fi
    
    # Clone the repository
    log_info "Cloning repository to $target_dir..."
    mkdir -p "$(dirname "$target_dir")"
    git clone "$repo" "$target_dir"
    cd "$target_dir"
    ROOT_DIR="$(pwd)"
    export ROOT_DIR
    log_success "Repository cloned successfully"
}

# Generate host_vars file for this host
generate_host_vars() {
    local hostname="$(hostname -s)"
    local host_vars_file="$ROOT_DIR/host_vars/${hostname}.yml"
    
    if [ -f "$host_vars_file" ]; then
        log_info "Host vars file already exists: $host_vars_file"
        return 0
    fi
    
    log_info "Generating host_vars file for $hostname..."
    
    # Determine if workstation or server
    local host_type="server"
    if [ "$IS_MAC" = true ] || [ -n "$DISPLAY" ] || [ "$IS_WSL" = true ]; then
        host_type="workstation"
    fi
    
    # Create host_vars file
    cat > "$host_vars_file" << EOF
---
# Configuration for $hostname
# Generated by bootstrap script on $(date)

# Ansible-pull configuration
ansible_pull_enabled: true
ansible_pull_cron_minute: "*/30"
ansible_pull_cron_hour: "*"

# User configuration
user_configs:
  - system_user: root
    config_profile: root
  - system_user: $(whoami)
    config_profile: nsheaps  # TODO: Update this to match your profile

# Host type: $host_type
EOF
    
    log_success "Generated host_vars file: $host_vars_file"
    
    # Update inventory
    local inventory_file="$ROOT_DIR/hosts"
    if ! grep -q "^$hostname" "$inventory_file"; then
        log_info "Adding $hostname to inventory..."
        echo "" >> "$inventory_file"
        echo "[$host_type]" >> "$inventory_file"
        echo "$hostname" >> "$inventory_file"
    fi
}

# Run bootstrap playbook
run_bootstrap() {
    log_info "Running bootstrap playbook..."
    
    cd "$ROOT_DIR"
    
    # First, do a dry run
    log_info "Performing dry run..."
    if ! ansible-playbook playbooks/bootstrap.yml \
        --connection=local \
        --check \
        --diff \
        --extra-vars "running_as=$(whoami) root_dir=$ROOT_DIR"; then
        log_error "Dry run failed"
        exit 1
    fi
    
    # Ask for confirmation
    echo -e "${YELLOW}The dry run completed. Would you like to proceed with the actual bootstrap?${NC}"
    read -p "Continue? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_warning "Bootstrap cancelled by user"
        exit 0
    fi
    
    # Run the actual bootstrap
    log_info "Running bootstrap (this will require sudo)..."
    ansible-playbook playbooks/bootstrap.yml \
        --connection=local \
        --ask-become-pass \
        --extra-vars "running_as=$(whoami) root_dir=$ROOT_DIR"
    
    log_success "Bootstrap playbook completed"
}

# Run first ansible-pull
run_first_pull() {
    log_info "Running first ansible-pull..."
    
    # Ask for confirmation
    echo -e "${YELLOW}Would you like to run the first ansible-pull now?${NC}"
    read -p "This will configure your system according to the playbooks. Continue? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_info "You can run ansible-pull manually later with:"
        echo "  sudo ansible-pull -U $REPO_DEFAULT -C $DEFAULT_BRANCH"
        return 0
    fi
    
    # Run ansible-pull
    log_info "Running ansible-pull (this will require sudo)..."
    sudo ansible-pull \
        -U "$REPO_DEFAULT" \
        -C "$DEFAULT_BRANCH" \
        --ask-become-pass
    
    log_success "First ansible-pull completed"
}

# Main execution
main() {
    echo -e "${BLUE}n8-ansible Bootstrap Script v${SCRIPT_VERSION}${NC}"
    echo "========================================="
    
    # Check for sudo access
    log_info "Checking sudo access..."
    if ! sudo -n true 2>/dev/null; then
        log_info "Please enter your password for sudo access:"
        sudo true
    fi
    log_success "Sudo access confirmed"
    
    # Detect platform
    detect_platform
    
    # Install required packages
    install_packages
    
    # Setup SSH
    setup_ssh
    
    # Setup 1Password
    setup_1password
    
    # Setup GitHub
    setup_github
    
    # Setup repository
    setup_repository "${1:-}"
    
    # Generate host_vars
    generate_host_vars
    
    # Run bootstrap
    run_bootstrap
    
    # Run first ansible-pull
    run_first_pull
    
    log_success "Bootstrap process completed!"
    log_info "Your system will now automatically pull updates every 30 minutes"
}

# Run main function
main "$@"